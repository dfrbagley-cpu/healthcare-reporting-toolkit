{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dfrbagley-cpu.github.io/healthcare-reporting-toolkit/schemas/analysis-receipt.schema.json",
  "title": "Healthcare Reporting Toolkit analysis receipt",
  "description": "A versioned record of a local toolkit calculation, its assumptions, aggregate outputs, and source fingerprints when applicable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "assumptions",
    "calculation_digest",
    "generated_at",
    "inputs",
    "limitations",
    "outputs",
    "receipt_type",
    "schema_version",
    "sources",
    "tool",
    "toolkit_version",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "https://dfrbagley-cpu.github.io/healthcare-reporting-toolkit/schemas/analysis-receipt.schema.json"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "calculation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "object"
    },
    "receipt_type": {
      "const": "healthcare-reporting-toolkit-analysis-receipt"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sources": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/sourceFingerprint"
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "enum": [
            "reporting-window",
            "extract-change-auditor",
            "waitlist-capacity-planner"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolkit_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sourceFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byte_count",
        "column_count",
        "role",
        "row_count",
        "sha256"
      ],
      "properties": {
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "column_count": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "baseline",
            "current"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
